---
import Doc from "../../layouts/Doc.astro";
import { u } from "../../lib/site";
import { GUIDES } from "../../lib/guides";
---

<Doc
  title="Guides: getting videos onto Discord | Sub20"
  description="Short guides to compressing a video for Discord, its size limit, NVIDIA Instant Replay clips, iPhone videos and HEVC files."
  current="guides"
  heading="Guides to getting videos onto Discord"
  lead="Five short answers to the questions that come up when a clip won't send."
>
  <div class="cards">
    {GUIDES.map((g) => (
      <a href={u(`guides/${g.slug}/`)}>
        <b>{g.title}</b>
        <span>{g.summary}</span>
      </a>
    ))}
  </div>
</Doc>
