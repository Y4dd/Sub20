---
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";
import { u, GITHUB, RELEASES } from "../lib/site";
import { latestRelease, ROWS, cell, kindInText } from "../lib/release";

const release = await latestRelease();
// The formats Sub20 opens (crates/core/src/watch.rs VIDEO_EXTENSIONS), for the marquee.
// What a search engine is told about Sub20: only what the page itself says.
const software = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Sub20",
  description: "Trims video clips and compresses them on the graphics card until they fit Discord's upload limit.",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Windows 10, Windows 11, Linux",
  url: new URL(u(), Astro.site).href,
  downloadUrl: release?.url ?? RELEASES,
  ...(release ? { softwareVersion: release.version } : {}),
  license: "https://opensource.org/licenses/MIT",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  sameAs: [GITHUB],
};
const formats = ["MP4", "MOV", "MKV", "WebM", "AVI", "M4V", "WMV", "FLV", "MPEG", "TS", "M2TS", "3GP", "MXF", "VOB"];
---

<Base
  title="Sub20: video compressor for Discord clips, on Windows and Linux"
  description="Trim a clip, pick a size, and Sub20 encodes it on your graphics card until it fits Discord's upload limit. Free and open source."
  moments
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(software)} />
  <section class="hero hero--triptych" data-enter aria-labelledby="hero-h">
    <div class="wrap">
      <div class="hero-text grid hero__grid">
        <div class="span-3">
          <h1 id="hero-h">Video compressor for Discord clips</h1>
          <p class="hero__lead">Trim each clip with two handles, pick a size, and Sub20 encodes it on your graphics card until it fits: 20 MB unless you say otherwise.</p>
        </div>
        <div class="ly-collage span-6 start-4" role="img" aria-label="Pieces of Sub20's window: the trim bar, the list of clips, the size picker with Discord's limits, a finished 19.4 MB file with Copy, a compress running on the NVIDIA GPU, the options, the watched-folder history and the phone layout">
          <div class="ly-collage__set is-on">
            <div class="ly-piece" style="left: 4%; top: 6%; width: 92%; aspect-ratio: 968 / 154"><Shot name="trim" alt="" sizes="(min-width: 1024px) 570px, 78vw" eager /></div>
            <div class="ly-piece" style="left: 4%; top: 25%; width: 40%; aspect-ratio: 264 / 234"><Shot name="rail" alt="" sizes="(min-width: 1024px) 246px, 34vw" eager /></div>
            <div class="ly-piece live-size" style="left: 50%; top: 25%; width: 46%">
              <span class="is-on"><em><b>20</b> MB</em><small>Free</small></span>
              <span><em><b>50</b> MB</em><small>Nitro Basic</small></span>
              <span><em><b>500</b> MB</em><small>Server boost</small></span>
              <span><em><b>1</b> GB</em><small>Nitro</small></span>
            </div>
            <div class="ly-piece live-result" style="left: 4%; bottom: 4%; width: 80%">
              <span class="live-result__file"><i class="live-result__thumb"></i><span><b>harbour-drone-take3-20mb.mp4</b><small><em>19.4 MB</em>, down from 612 MB</small></span></span>
              <span class="live-result__copy">Copy</span>
            </div>
          </div>
          <div class="ly-collage__set" aria-hidden="true">
            <div class="ly-piece" style="left: 4%; top: 6%; width: 92%; aspect-ratio: 968 / 146"><Shot name="running" alt="" sizes="(min-width: 1024px) 570px, 78vw" loading="eager" fetchpriority="low" /></div>
            <div class="ly-piece" style="left: 4%; top: 24%; width: 44%; height: 72%"><Shot name="options" alt="" sizes="(min-width: 1024px) 271px, 39vw" style="object-position: 50% 0" loading="eager" fetchpriority="low" /></div>
            <div class="ly-piece" style="right: 4%; bottom: 4%; width: 48%; aspect-ratio: 424 / 180"><Shot name="mix" alt="" sizes="(min-width: 1024px) 296px, 41vw" loading="eager" fetchpriority="low" /></div>
          </div>
          <div class="ly-collage__set" aria-hidden="true">
            <div class="ly-piece" style="left: 4%; top: 6%; width: 50%; height: 62%"><Shot name="watch" alt="" sizes="(min-width: 1024px) 308px, 43vw" style="object-position: 50% 0" loading="eager" fetchpriority="low" /></div>
            <div class="ly-piece" style="right: 4%; bottom: 4%; width: 38%; height: 82%"><Shot name="phone" alt="" sizes="(min-width: 1024px) 270px, (min-width: 640px) 248px, 43vw" style="object-position: 50% 0" loading="eager" fetchpriority="low" /></div>
          </div>
        </div>
        <div class="span-3 start-10 hero__cta"><a class="btn btn--primary" href="#download">Download Sub20</a></div>
      </div>
    </div>
  </section>

  <section class="section" id="app" aria-labelledby="app-h">
    <div class="wrap">
      <div class="grid">
        <h2 class="span-5" id="app-h">Your clips and the trim in one window</h2>
        <p class="span-6 start-7 app__lead">Drop videos on the window, pick one, and drag the yellow handles to the part worth sending. The line under the picture says what will come out: length, resolution and how it should look.</p>
      </div>
      <div class="app-shot fill">
        <Shot name="app" alt="Sub20's window: three clips on the left, a drone video on the stage with its trim bar, 1080p planned, and Compress 3 videos at 20 MB" sizes="1270px" />
      </div>
    </div>
  </section>

  <section class="section g2" id="features" aria-labelledby="features-h">
    <div class="wrap">
      <div class="group">
        <div class="section-head">
          <h2 id="features-h">Made for clips on their way to Discord. <span class="muted">Each file is measured before it is saved.</span></h2>
        </div>
        <div class="grid">
          <article class="card card--row card--open span-6">
            <h3>Measures every clip against the limit</h3>
            <p>A result one byte over is encoded again at a lower bitrate. A file over the limit is never saved.</p>
            <div class="panel shot shot--contain"><Shot name="size" alt="The size picker: 20 MB Free, 50 MB Nitro Basic, 500 MB Server boost, 1 GB Nitro" sizes="(min-width: 1280px) 504px, (min-width: 1024px) 365px, (min-width: 640px) 269px, 146px" /></div>
          </article>
          <article class="card card--row card--open span-6">
            <h3>Encodes the video on your graphics card</h3>
            <p>NVIDIA, AMD and Intel cards do the work; the CPU takes over when a card can't.</p>
            <div class="panel shot shot--wide"><Shot name="running" alt="The trim bar filling from the left, Compressing on the NVIDIA GPU, 42%, about 5 s left" sizes="(min-width: 1280px) 573px, (min-width: 1024px) 365px, (min-width: 640px) 269px, 303px" /></div>
          </article>
        </div>
      </div>
      <div class="group">
        <div class="formats" data-moment="marquee-row" data-moment-opts='{"speed": 36}' aria-label="Formats Sub20 opens">
          <ul class="mo-mq__track">{formats.map((f) => <li>{f}</li>)}</ul>
        </div>
        <div class="grid">
          <article class="card card--row card--open span-6">
            <h3>Picks up new clips from your folders</h3>
            <p>Point Sub20 at the NVIDIA app's or Xbox Game Bar's folder and new clips are compressed as they land.</p>
            <div class="panel shot shot--top"><Shot name="watch" alt="History: a clip from the watched NVIDIA folder, 612 MB to 19.4 MB, with Open and Copy" sizes="(min-width: 1024px) 277px, (min-width: 640px) 130px, 71px" /></div>
          </article>
          <article class="card card--row card--open span-6">
            <h3>Keeps the microphone in every clip</h3>
            <p>OBS and the NVIDIA app can record the mic on a track of its own. Sub20 mixes every track into one.</p>
            <div class="panel shot shot--contain"><Shot name="mix" alt="Options: Mix all sound tracks switched on" sizes="(min-width: 1280px) 573px, (min-width: 1024px) 365px, (min-width: 640px) 269px, 272px" /></div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="download" aria-labelledby="download-h">
    <div class="wrap">
      <div class="grid fill">
        <div class="span-5 downloads">
          <h2 id="download-h">Download Sub20 for Windows and Linux</h2>
          <p>Sub20 has FFmpeg built in. Sub20 without FFmpeg is a smaller download that uses the FFmpeg on your computer, or fetches it once.</p>
          <ul class="downloads__list" role="list">
            {ROWS.map((row) => {
              const full = cell(release, row, false);
              const lean = cell(release, row, true);
              return (
                <li data-os={row.os}>
                  <span><b>{row.system}</b> <span class="muted">{row.detail}, {kindInText(row.kind)}</span></span>
                  <span class="downloads__links">
                    <a class="link" href={full.href}>Sub20{full.size && `, ${full.size}`}</a>
                    <a class="link" href={lean.href}>Without FFmpeg{lean.size && `, ${lean.size}`}</a>
                  </span>
                </li>
              );
            })}
          </ul>
          <p class="downloads__after">
            {release ? <span class="muted">Version {release.version}.</span> : <span class="muted">Every version is on the <a href={RELEASES}>releases page</a>.</span>}
            <a class="link" href={u("download/")}>Read the install steps</a>
          </p>
        </div>
        <div class="frame frame--split frame--fill span-6 start-7 downloads__frame">
          <Shot class="frame__img" name="empty" alt="Sub20's first screen: the yellow trim bracket and Drop videos here" sizes="(min-width: 1280px) 523px, (min-width: 1024px) 315px, (min-width: 640px) 550px, 370px" />
        </div>
      </div>
    </div>
  </section>

  <section class="section ground-surface" id="lite" aria-labelledby="lite-h">
    <div class="wrap">
      <div class="grid fill">
        <div class="span-5 lite__text">
          <h2 id="lite-h">Sub20 Lite runs in your browser</h2>
          <p class="t-lead">The same window on a phone or a computer, encoding with the browser's own video encoder. Nothing is uploaded, and on a phone Share hands the result to the Discord app.</p>
          <ul class="lite__facts" role="list">
            <li>H.264 at the size you pick, measured and redone if it's over</li>
            <li>Installs as an app and opens without a connection</li>
            <li>Android: share a video from the gallery straight into it</li>
          </ul>
          <a class="link" href={u("app/")}>Open Sub20 Lite</a>
        </div>
        <div class="frame frame--split frame--fill span-6 start-7 lite__frame">
          <Shot class="lite__phone" name="phone" alt="Sub20 Lite on a phone: the clip strip, the preview, the trim bar and Compress 3 videos at 20 MB" sizes="(min-width: 1024px) 304px, (min-width: 640px) 335px, 155px" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="faq" aria-labelledby="faq-h">
    <div class="wrap">
      <div class="grid">
        <div class="span-5 stack-4">
          <h2 id="faq-h">Questions</h2>
          <p class="muted">Something else, or something broken? Open an issue on GitHub.</p>
          <a class="link" href="https://github.com/Y4dd/Sub20/issues/new/choose">Open an issue</a>
          <Shot class="faq__shot" name="about" alt="Sub20's About line: Copy diagnostics for a bug report, and Sub20 sends nothing about you anywhere" sizes="(min-width: 640px) 424px, 327px" />
        </div>
        <div class="faq span-6 start-7">
          <div class="faq__item"><h3>Is Sub20 free?</h3><p>Yes, with no account and no ads. The code is open under the MIT licence.</p></div>
          <div class="faq__item"><h3>Are my videos uploaded anywhere?</h3><p>No. Sub20 works on your computer, and Lite inside your browser. The update check is the only request Sub20 makes by itself.</p></div>
          <div class="faq__item"><h3>Which Discord size should I pick?</h3><p>20 MB for a free Discord account, 50 MB with Nitro Basic, 500 MB in a boosted server, 1 GB with Nitro.</p></div>
          <div class="faq__item"><h3>Why H.264 and not HEVC?</h3><p>H.264 plays in Discord on every computer and phone. HEVC and AV1 keep more detail at the same size, but some devices won't play them in the chat: HEVC older computers, AV1 phones. Both are in Options.</p></div>
          <div class="faq__item"><h3>Why does Windows warn me about the installer?</h3><p>Sub20 isn't code-signed yet. Click More info, then Run anyway; <a href={u("download/")}>the install steps</a> show where.</p></div>
        </div>
      </div>
    </div>
  </section>
</Base>
