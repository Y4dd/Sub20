---
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";
import DownloadMark from "../components/DownloadMark.astro";
import { u, GITHUB, RELEASES } from "../lib/site";
import { latestRelease, ROWS, cell, kindInText } from "../lib/release";
import { GUIDES } from "../lib/guides";
import GetSub20 from "../components/GetSub20.astro";
import SmartScreenNote from "../components/SmartScreenNote.astro";
import PayoffStory from "../components/PayoffStory.astro";

const release = await latestRelease();
// A size keeps its unit and "64-bit" its hyphen on one line.
const keep = (t: string) => t.replace(/(\d) (MB|GB|KB)/g, "$1\u00a0$2").replace(/-bit/g, "\u2011bit");
// What a search engine is told about Sub20: only what the page itself says.
const software = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Sub20",
  description: "Trims video clips and compresses them on the graphics card until they fit Discord's upload limit.",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Windows 10, Windows 11, Linux",
  url: new URL(u(), Astro.site).href,
  downloadUrl: release?.url ?? RELEASES,
  ...(release ? { softwareVersion: release.version } : {}),
  license: "https://opensource.org/licenses/MIT",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  sameAs: [GITHUB],
};
// The questions, written once: the page shows them, and FAQPage tells search engines the same words, in this order.
// Windows's warning sits third, so the section ends on reassurance (nothing uploaded) and not on the warning the close's
// Windows button repeats right after it. Keep each question's words as they are; the warning's are the owner's.
const FAQ = [
  { q: "How do I make a video small enough for Discord?", html: "Add it to Sub20, drag the yellow handles to keep the part worth sending, pick the size and press Compress. Sub20 works out the bitrate from the size and the length you kept, and encodes the clip again if it lands even a byte over." },
  { q: "What is Discord's file size limit?", html: "20 MB on a free account, 50 MB with Nitro Basic, 500 MB in a boosted server and 1 GB with Nitro. Sub20's size picker names each one." },
  { q: "Why does Windows warn me about the installer?", html: `Because Sub20 is not code-signed yet. Click More info, then Run anyway; <a href="${u("download/")}">the install steps</a> show where.` },
  { q: "Will my clip play for everyone on Discord?", html: "Yes, unless you choose otherwise. Sub20 saves H.264 video, the kind that plays in Discord on every computer and phone. Options also offers HEVC and AV1, which keep more detail at the same size but may not play everywhere: HEVC on some computers, AV1 on phones." },
  { q: "Are my videos uploaded anywhere?", html: "No, and there is no account. Sub20 works on your computer, and Lite inside your browser. The update check is the only request Sub20 makes by itself." },
];
const faqPage = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ.map((q) => ({ "@type": "Question", name: q.q, acceptedAnswer: { "@type": "Answer", text: q.html.replace(/<[^>]+>/g, "") } })),
};
// Formats Sub20 opens, from crates/core/src/watch.rs VIDEO_EXTENSIONS (not all: MPG, 3G2, MTS and OGV are left out), in a trim bracket.
const formats = ["MP4", "MOV", "MKV", "WebM", "AVI", "M4V", "WMV", "FLV", "MPEG", "TS", "M2TS", "3GP", "MXF", "VOB"];
---

<Base
  title="Compress video for Discord: Sub20, free for Windows and Linux"
  description="Video too big for Discord? Trim it, pick a size, and Sub20 compresses it on your graphics card until it fits the 20 MB upload limit. Free and open source."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(software)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqPage)} />
  <section class="hero hero--centred" data-enter aria-labelledby="hero-h">
    <div class="wrap"><div class="hero-text">
      <div class="hero__c">
        <a class="pill" href={u("changelog/")}><span>{release ? `Sub20 ${release.version}` : "Free and open source"}</span><span class="muted">Read the changelog</span></a>
        <h1 id="hero-h">Video compressor for <span class="trim">Discord clips</span></h1>
        <p class="hero__lead"><span class="if-app">Trim a clip, pick a size, and Sub20 encodes it on your graphics card until it fits: 20 MB unless you say otherwise.</span><span class="if-lite">Trim a clip and Sub20 Lite fits it in your browser: 20 MB unless you pick another size. On a phone, Share hands it to Discord.</span></p>
        <div class="btn-row"><GetSub20 class="btn btn--primary if-app" jump="#download" /><a class="btn btn--secondary if-app" href={u("app/")}>Try it in your browser</a><a class="btn btn--primary if-lite" href={u("app/")}>Open Sub20 Lite</a><a class="link if-lite hero__other" href="#download">Download for Windows or Linux</a></div>
        <SmartScreenNote class="hero__note" />
      </div>
      {/* The window's width as site.css draws it (measured from 640 to 2560px wide, 700 to 1440px tall): the column,
          100vw - 160px, up to 1120px; only where the frame's inside is 280 to 420px tall (a screen about 840 to 990px tall)
          is it the whole window at 880 to 1120px, said as 960px for the screens up to 930px tall. A phone has its own. */}
      <div class="hero__window" role="img" aria-label="Sub20's window: a drone clip with the yellow trim bar over its frames, planned at 1080p and marked Should look good, and at the foot the size, 20 MB, and Compress 3 videos">
        <div class="ly-piece"><Shot name="window" alt="" sizes="(min-width: 1024px) and (min-height: 840px) and (max-height: 930px) 960px, (min-width: 1280px) 1120px, calc(100vw - 160px)" phone={{ name: "window-narrow", sizes: "calc(100vw - 80px)" }} eager /></div>
      </div>
    </div></div>
  </section>

  <section class="section g2" id="features" aria-labelledby="features-h">
    <div class="wrap">
      <div class="group">
        <div class="section-head">
          <h2 id="features-h">Made for clips on their way to Discord. <span class="muted">Keep the part worth sending, and Sub20 makes it fit.</span></h2>
        </div>
        <div class="grid">
          <article class="card card--row card--open span-6">
            <h3>Measures every clip against the limit</h3>
            <p>A result one byte over is encoded again at a lower bitrate. A file over the limit is never saved.</p>
            <div class="panel shot"><Shot name="size" alt="The size picker: 20 MB Free, 50 MB Nitro Basic, 500 MB Server boost, 1 GB Nitro" sizes="(min-width: 1280px) 372px, (min-width: 1024px) min(372px, calc(50vw - 150px)), 372px" phone={{ name: "size-narrow", sizes: "calc(100vw - 72px)" }} /></div>
          </article>
          <article class="card card--row card--open span-6">
            <h3>Encodes the video on your graphics card</h3>
            <p>NVIDIA, AMD and Intel cards do the work; the CPU takes over when a card can't.</p>
            <div class="panel shot"><Shot name="running" alt="Under the video, the trim bar filling from the left: Compressing on the NVIDIA GPU, 42%, about 5 s left" sizes="(min-width: 1280px) 570px, (min-width: 1024px) calc(50vw - 150px), 570px" phone={{ name: "running-narrow", sizes: "calc(100vw - 72px)" }} /></div>
          </article>
        </div>
      </div>
      <div class="group">
        <figure class="kinds">
          <figcaption>Opens {formats.slice(0, 3).join(", ")} and {formats.length - 3} more</figcaption>
          <ul class="kinds__rail" role="list">{formats.map((f) => <li>{f}</li>)}</ul>
        </figure>
        <div class="grid">
          <article class="card card--row card--open span-6">
            <h3>Picks up new clips from your folders</h3>
            <p>In the desktop app, point Sub20 at the NVIDIA app's or Xbox Game Bar's folder and it picks up each new clip as it lands.</p>
            <div class="panel shot shot--low"><Shot name="watch" alt="History: the watched folder C:\Users\demo\Videos\NVIDIA, 1 clip done, clutch-1v4-ranked-20mb.mp4, 248 MB to 19.4 MB, with Open and Copy" sizes="(min-width: 1280px) 480px, (min-width: 1024px) calc(50vw - 150px), 480px" phone={{ name: "watch-narrow", sizes: "calc(100vw - 72px)" }} /></div>
          </article>
          <article class="card card--row card--open span-6">
            <h3>Keeps the microphone in every clip</h3>
            <p>OBS and the NVIDIA app can record the mic on a track of its own. Sub20 mixes every track into one.</p>
            <div class="panel shot shot--low"><Shot name="mix" alt="Options: Mix all sound tracks switched on, which keeps a microphone that OBS or the NVIDIA app recorded on its own track" sizes="(min-width: 1280px) 480px, (min-width: 1024px) calc(50vw - 150px), 480px" phone={{ name: "mix-narrow", sizes: "calc(100vw - 72px)" }} /></div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="download" aria-labelledby="download-h">
    <div class="wrap">
      <div class="grid">
        <div class="span-5 downloads">
          <h2 id="download-h"><span class="if-app">Download Sub20 for Windows and Linux</span><span class="if-lite">The desktop app</span></h2>
          <p class="downloads__fallback">Free and open source, for Windows 10 and 11 and {keep("64-bit")} Linux. Pick your system below.</p>
          {/* One button for the visitor's system (data-os, set by Base's head script); none without JavaScript.
              A button or link that starts a download carries .dl and ends in DownloadMark (never the page arrow);
              without a release to read, they go to the releases page and stay page links. */}
          {(() => {
            const win = cell(release, ROWS[0], false);
            const deb = cell(release, ROWS[1], false);
            const rpm = cell(release, ROWS[2], false);
            const app = cell(release, ROWS[3], false);
            const version = release ? `, version ${release.version}` : "";
            return (
              <>
                <div class="downloads__pick" data-for="windows">
                  <a class:list={["btn btn--primary", { dl: win.size }]} href={win.href}><span>Download for Windows{win.size && <span class="downloads__size">, {keep(win.size)}</span>}</span>{win.size && <DownloadMark />}</a>
                  <p class="downloads__note">Windows 10 and 11, {keep("64-bit")} installer{version}.</p>
                </div>
                <div class="downloads__pick" data-for="linux">
                  <a class:list={["btn btn--primary", { dl: deb.size }]} href={deb.href}><span>Download for Linux (.deb){deb.size && <span class="downloads__size">, {keep(deb.size)}</span>}</span>{deb.size && <DownloadMark />}</a>
                  <p class="downloads__note">The {keep("64-bit")} package for Ubuntu, Debian and Mint{version}.</p>
                  <p class="downloads__note">Fedora or openSUSE: <a class:list={["link", { dl: rpm.size }]} href={rpm.href}>the .rpm{rpm.size && `, ${keep(rpm.size)}`}{rpm.size && <DownloadMark />}</a>. Any other Linux: <a class:list={["link", { dl: app.size }]} href={app.href}>the AppImage{app.size && `, ${keep(app.size)}`}{app.size && <DownloadMark />}</a>.</p>
                </div>
              </>
            );
          })()}
          {/* Windows's warning in full, with its reason and the install steps (the FAQ's words; the hero and the close
              say only the next step): under the Windows button, and without JavaScript (or on a system the page can't
              tell) under the line above; not on Linux, nor where the desktop app doesn't run. */}
          <SmartScreenNote class="downloads__note downloads__warn" steps />
          {/* Where the desktop app doesn't run (data-lite), #lite comes before this section and is the way in on this
              device, so here only how to get the desktop app onto a computer; its files are behind "Other systems and downloads". */}
          <div class="downloads__lite if-lite">
            <p>It runs on Windows 10 and 11 and {keep("64-bit")} Linux. To install it, open this page on that computer, or take its file below.</p>
          </div>
        </div>
        {/* What the download is for, one game clip from plan to Discord (PayoffStory, Lite's own in #lite). Not
            where the desktop app doesn't run: there this section is the way to a computer's files, and #lite tells the story. */}
        <PayoffStory path="app" class="span-6 start-7 if-app" />
        {/* Every file. Open as written, so it is the whole list without JavaScript or on a system the page
            can't tell. The script under it closes it where a button above already offers the right file, and where
            the desktop app doesn't run (data-lite), since Lite comes first there; a link to #download opens it again. */}
        <details class="downloads__more" open>
          <summary>Other systems and downloads</summary>
          <div class="downloads__all">
            <p>Each system has two downloads. <b>Sub20</b> has FFmpeg, the part that does the compressing, built in: take this one. <b>Without FFmpeg</b> is smaller because it leaves FFmpeg out: it uses the one already on your computer, or offers to download it the first time it opens.</p>
            <ul class="downloads__list" role="list">
              {ROWS.map((row) => {
                const full = cell(release, row, false);
                const lean = cell(release, row, true);
                return (
                  <li>
                    <span><b>{row.system}</b> <span class="muted">{keep(row.detail)}, {kindInText(row.kind)}</span></span>
                    <span class="downloads__links">
                      <a class:list={["link", { dl: full.size }]} href={full.href}><span>Sub20{full.size && <span class="downloads__size">, {keep(full.size)}</span>}</span>{full.size && <DownloadMark />}</a>
                      <a class:list={["link", { dl: lean.size }]} href={lean.href}><span>Without FFmpeg{lean.size && <span class="downloads__size">, {keep(lean.size)}</span>}</span>{lean.size && <DownloadMark />}</a>
                    </span>
                  </li>
                );
              })}
            </ul>
            <p class="downloads__after">
              {release ? <span class="muted">Version {release.version}.</span> : <span class="muted">Every version is on the <a href={RELEASES}>releases page</a>.</span>}
              <a class="link" href={u("download/")}>Read the install steps</a>
            </p>
          </div>
        </details>
        <script is:inline>(()=>{const t=document.currentScript.previousElementSibling,d=document.documentElement.dataset,l="lite"in d;if(!l&&d.os!=="windows"&&d.os!=="linux")return;t.open=false;if(!l)return;const o=()=>{if(location.hash==="#download")t.open=true};o();addEventListener("hashchange",o);document.addEventListener("click",e=>{if(e.target.closest&&e.target.closest('a[href$="#download"]'))t.open=true})})()</script>
      </div>
    </div>
  </section>

  <section class="section ground-surface" id="lite" aria-labelledby="lite-h">
    <div class="wrap">
      <div class="grid fill">
        <div class="span-5 lite__text">
          <h2 id="lite-h">Sub20 Lite runs in your browser</h2>
          {/* Share is said once on each page: here on a computer, in the hero's lead where the desktop app doesn't run. */}
          <p class="t-lead">The same window in any browser, and the way in on a phone or a Mac, where the desktop app doesn't run. <span class="if-app">It encodes on your device, uploads nothing, and on a phone Share hands the result to Discord.</span><span class="if-lite">It encodes on your device and uploads nothing.</span></p>
          <ul class="lite__facts" role="list">
            <li>Saves an MP4 at the size you pick, measured and redone if it's over</li>
            <li>Install it from Chrome or Edge, or on an iPhone with {"Add to Home Screen".replace(/ /g, " ")}, and it works offline</li>
            <li>Installed on Android, it takes videos shared from the gallery</li>
          </ul>
          <a class="link" href={u("app/")}>Open Sub20 Lite</a>
        </div>
        {/* On a computer, Lite on a phone. Where the desktop app doesn't run (data-lite) this is the visitor's own way
            in, so the frame tells Lite's story instead: the clip from plan to Discord, handed on with Share or Download
            (the hero shows the window there already). */}
        <div class="frame frame--split frame--fill span-6 start-7 lite__frame if-app">
          <Shot class="lite__phone" name="phone" alt="Sub20 Lite on a phone: the clip strip, the preview, the trim bar and Compress 3 videos at 20 MB" sizes="(min-width: 1024px) 304px, (min-width: 640px) 335px, 155px" />
        </div>
        <PayoffStory path="lite" class="span-6 start-7 if-lite" />
      </div>
    </div>
    {/* Where the desktop app doesn't run (data-lite), Lite is the way in, so this section moves up before #download:
        in the DOM, not with CSS order, so focus and a screen reader follow what is seen. Without JavaScript, and on
        Windows or Linux, it stays where it is written. It runs before system.js, a module that waits for the parse.
        There the phone's frame, hidden (Lite's story takes its place), goes too: system.js fetches every lazy image
        once the page has loaded, hidden ones included. */}
    <script is:inline>(()=>{const s=document.currentScript.parentElement,d=document.getElementById("download");if(!("lite"in document.documentElement.dataset))return;s.querySelector(".lite__frame")?.remove();if(d)d.before(s)})()</script>
  </section>

  <section class="section" id="faq" aria-labelledby="faq-h" style="--hm: 2">
    <div class="wrap">
      {/* Three blocks in reading order, heading, answers, guides, so a phone (stacked) reads the answers before the
          guides, and focus and a screen reader follow it. From 1024px site.css places them in two columns again:
          the heading over the guides on the left, the answers on the right. */}
      <div class="grid faq__grid">
        <div class="faq__head span-5">
          <h2 id="faq-h">Questions about Discord clips</h2>
        </div>
        <div class="faq span-6 start-7">
          {FAQ.map((q) => <div class="faq__item"><h3>{q.q}</h3><p set:html={q.html} /></div>)}
        </div>
        <div class="faq__more span-5 stack-4">
          <p class="muted">The guides go further, step by step.</p>
          {/* Each guide with its one-line summary (GUIDES), so the column beside the five answers says what each holds. */}
          <ul class="faq__guides" role="list">
            {GUIDES.map((g) => <li><a class="link" href={u(`guides/${g.slug}/`)}>{g.title}</a><span>{g.summary}</span></li>)}
            <li><a class="link" href={`${GITHUB}/issues/new/choose`}>Open an issue</a><span>Something else, or something broken? Ask on GitHub.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>
