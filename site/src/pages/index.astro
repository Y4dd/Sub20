---
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";
import { u, GITHUB, RELEASES } from "../lib/site";
import { latestRelease, ROWS, cell, kindInText } from "../lib/release";
import { GUIDES } from "../lib/guides";

const release = await latestRelease();
// A size keeps its unit and "64-bit" its hyphen on one line.
const keep = (t: string) => t.replace(/(\d) (MB|GB|KB)/g, "$1\u00a0$2").replace(/-bit/g, "\u2011bit");
// What a search engine is told about Sub20: only what the page itself says.
const software = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Sub20",
  description: "Trims video clips and compresses them on the graphics card until they fit Discord's upload limit.",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Windows 10, Windows 11, Linux",
  url: new URL(u(), Astro.site).href,
  downloadUrl: release?.url ?? RELEASES,
  ...(release ? { softwareVersion: release.version } : {}),
  license: "https://opensource.org/licenses/MIT",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  sameAs: [GITHUB],
};
// The questions, written once: the page shows them, and FAQPage tells search engines the same words.
const FAQ = [
  { q: "How do I make a video small enough for Discord?", html: "Drop it on Sub20, drag the yellow handles to keep the part worth sending, pick the size and press Compress. Sub20 works out the bitrate from the size and the length you kept, and encodes the clip again if it lands even a byte over." },
  { q: "What is Discord's file size limit?", html: "20 MB on a free account, 50 MB with Nitro Basic, 500 MB in a boosted server and 1 GB with Nitro. Sub20's size picker names each one." },
  { q: "Are my videos uploaded anywhere?", html: "No, and there is no account. Sub20 works on your computer, and Lite inside your browser. The update check is the only request Sub20 makes by itself." },
  { q: "Why H.264 and not HEVC?", html: "H.264 plays in Discord on every computer and phone. HEVC and AV1 keep more detail at the same size, but may not play everywhere: HEVC on some computers, AV1 on phones. Both are in Options." },
  { q: "Why does Windows warn me about the installer?", html: `Sub20 isn't code-signed yet. Click More info, then Run anyway; <a href="${u("download/")}">the install steps</a> show where.` },
];
const faqPage = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ.map((q) => ({ "@type": "Question", name: q.q, acceptedAnswer: { "@type": "Answer", text: q.html.replace(/<[^>]+>/g, "") } })),
};
// The formats Sub20 opens (crates/core/src/watch.rs VIDEO_EXTENSIONS), for the marquee.
const formats = ["MP4", "MOV", "MKV", "WebM", "AVI", "M4V", "WMV", "FLV", "MPEG", "TS", "M2TS", "3GP", "MXF", "VOB"];
---

<Base
  title="Compress video for Discord: Sub20, free for Windows and Linux"
  description="Video too big for Discord? Trim it, pick a size, and Sub20 compresses it on your graphics card until it fits the 20 MB upload limit. Free and open source."
  moments
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(software)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqPage)} />
  <section class="hero hero--centred" data-enter aria-labelledby="hero-h">
    <div class="wrap"><div class="hero-text">
      <div class="hero__c">
        <a class="pill" href={u("changelog/")}><span>{release ? `Sub20 ${release.version}` : "Free and open source"}</span><span class="muted">Read the changelog</span></a>
        <h1 id="hero-h">Video compressor for Discord clips</h1>
        <p class="hero__lead">Trim a clip, pick a size, and Sub20 encodes it on your graphics card until it fits: 20 MB unless you say otherwise.</p>
        <div class="btn-row"><a class="btn btn--primary if-app" href="#download">Download Sub20</a><a class="btn btn--secondary if-app" href={u("app/")}>Try it in your browser</a><a class="btn btn--primary if-lite" href={u("app/")}>Open Sub20 Lite</a><a class="btn btn--secondary if-lite" href="#download">Download for your computer</a></div>
      </div>
      <div class="hero__window" role="img" aria-label="Sub20's window: a drone clip with the yellow trim bar over its frames, planned at 1080p and marked Should look good, and at the foot the size, 20 MB, and Compress 3 videos">
        <div class="ly-piece"><Shot name="window" alt="" sizes="(min-width: 1280px) and (min-height: 1000px) 1120px, (min-width: 960px) 960px, calc(100vw - 80px)" phone={{ name: "window-narrow", sizes: "calc(100vw - 80px)" }} eager /></div>
      </div>
    </div></div>
  </section>

  <section class="section g2" id="features" aria-labelledby="features-h">
    <div class="wrap">
      <div class="group">
        <div class="section-head">
          <h2 id="features-h">Made for clips on their way to Discord. <span class="muted">Each file is measured before it is saved.</span></h2>
        </div>
        <div class="grid">
          <article class="card card--row card--open span-6">
            <h3>Measures every clip against the limit</h3>
            <p>A result one byte over is encoded again at a lower bitrate. A file over the limit is never saved.</p>
            <div class="panel shot shot--contain"><Shot name="size" alt="The size picker: 20 MB Free, 50 MB Nitro Basic, 500 MB Server boost, 1 GB Nitro" sizes="(min-width: 1280px) 504px, (min-width: 1024px) 365px, (min-width: 640px) 269px, 146px" /></div>
          </article>
          <article class="card card--row card--open span-6">
            <h3>Encodes the video on your graphics card</h3>
            <p>NVIDIA, AMD and Intel cards do the work; the CPU takes over when a card can't.</p>
            <div class="panel shot shot--wide"><Shot name="running" alt="The trim bar filling from the left, Compressing on the NVIDIA GPU, 42%, about 5 s left" sizes="(min-width: 1280px) 573px, (min-width: 1024px) 365px, (min-width: 640px) 269px, 303px" /></div>
          </article>
        </div>
      </div>
      <div class="group">
        <div class="formats" data-moment="marquee-row" data-moment-opts='{"speed": 36}' aria-label="Formats Sub20 opens">
          <ul class="mo-mq__track">{formats.map((f) => <li>{f}</li>)}</ul>
        </div>
        <div class="grid">
          <article class="card card--row card--open span-6">
            <h3>Picks up new clips from your folders</h3>
            <p>Point Sub20 at the NVIDIA app's or Xbox Game Bar's folder and new clips are compressed as they land.</p>
            <div class="panel shot shot--top"><Shot name="watch" alt="History: a clip from the watched NVIDIA folder, 612 MB to 19.4 MB, with Open and Copy" sizes="(min-width: 1024px) 277px, (min-width: 640px) 130px, 71px" /></div>
          </article>
          <article class="card card--row card--open span-6">
            <h3>Keeps the microphone in every clip</h3>
            <p>OBS and the NVIDIA app can record the mic on a track of its own. Sub20 mixes every track into one.</p>
            <div class="panel shot shot--contain"><Shot name="mix" alt="Options: Mix all sound tracks switched on" sizes="(min-width: 1280px) 573px, (min-width: 1024px) 365px, (min-width: 640px) 269px, 272px" /></div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="download" aria-labelledby="download-h">
    <div class="wrap">
      <div class="grid fill">
        <div class="span-5 downloads">
          <h2 id="download-h">Download Sub20 for Windows and Linux</h2>
          <p>Sub20 has FFmpeg built in. Sub20 without FFmpeg is a smaller download that uses the FFmpeg on your computer, or fetches it once.</p>
          <ul class="downloads__list" role="list">
            {ROWS.map((row) => {
              const full = cell(release, row, false);
              const lean = cell(release, row, true);
              return (
                <li data-os={row.os}>
                  <span><b>{row.system}</b> <span class="muted">{keep(row.detail)}, {kindInText(row.kind)}</span></span>
                  <span class="downloads__links">
                    <a class="link" href={full.href}>Sub20{full.size && `, ${keep(full.size)}`}</a>
                    <a class="link" href={lean.href}>Without FFmpeg{lean.size && `, ${keep(lean.size)}`}</a>
                  </span>
                </li>
              );
            })}
          </ul>
          <p class="downloads__after">
            {release ? <span class="muted">Version {release.version}.</span> : <span class="muted">Every version is on the <a href={RELEASES}>releases page</a>.</span>}
            <a class="link" href={u("download/")}>Read the install steps</a>
          </p>
        </div>
        <div class="frame frame--split frame--fill span-6 start-7 downloads__frame">
          <Shot class="frame__img" name="empty" alt="Sub20's first screen: the yellow trim bracket and Drop videos here" sizes="(min-width: 1280px) 523px, (min-width: 1024px) 315px, (min-width: 640px) 550px, 370px" />
        </div>
      </div>
    </div>
  </section>

  <section class="section ground-surface" id="lite" aria-labelledby="lite-h">
    <div class="wrap">
      <div class="grid fill">
        <div class="span-5 lite__text">
          <h2 id="lite-h">Sub20 Lite runs in your browser</h2>
          <p class="t-lead">The same window in any browser, and the way in on a phone or a Mac, where the desktop app doesn't run. It encodes on your device, uploads nothing, and on a phone Share hands the result to Discord.</p>
          <ul class="lite__facts" role="list">
            <li>H.264 at the size you pick, measured and redone if it's over</li>
            <li>Installs as an app and works offline</li>
            <li>Android: share a video from the gallery straight into it</li>
          </ul>
          <a class="link" href={u("app/")}>Open Sub20 Lite</a>
        </div>
        <div class="frame frame--split frame--fill span-6 start-7 lite__frame">
          <Shot class="lite__phone" name="phone" alt="Sub20 Lite on a phone: the clip strip, the preview, the trim bar and Compress 3 videos at 20 MB" sizes="(min-width: 1024px) 304px, (min-width: 640px) 335px, 155px" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="faq" aria-labelledby="faq-h" style="--hm: 2">
    <div class="wrap">
      <div class="grid">
        <div class="span-5 stack-4">
          <h2 id="faq-h">Questions about Discord clips</h2>
          <p class="muted">The guides go further, step by step. Something else, or something broken? Open an issue on GitHub.</p>
          <ul class="faq__guides" role="list">
            {GUIDES.map((g) => <li><a class="link" href={u(`guides/${g.slug}/`)}>{g.title}</a></li>)}
            <li><a class="link" href={`${GITHUB}/issues/new/choose`}>Open an issue</a></li>
          </ul>
          <Shot class="faq__shot" name="done" alt="A finished clip in Sub20: harbour-drone-take3-20mb.mp4, 19.4 MB, down from 612 MB, with Copy and Ctrl+C" sizes="(min-width: 640px) 485px, calc(100vw - 32px)" />
        </div>
        <div class="faq span-6 start-7">
          {FAQ.map((q) => <div class="faq__item"><h3>{q.q}</h3><p set:html={q.html} /></div>)}
        </div>
      </div>
    </div>
  </section>
</Base>
